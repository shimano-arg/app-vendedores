{
  "name": "app-vendedores-shimano",
  "version": "0.0.0",
  "private": true,
  "description": "Shimano App Vendedores - build + test tooling (Fase 0). Deps por etapa para minimizar surface en cada install.",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "test:unit": "vitest run tests/unit/",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules/\"",
    "test:functions": "firebase emulators:exec --only functions,firestore,auth \"vitest run tests/functions/\"",
    "test:smoke": "vitest run tests/smoke/",
    "test:e2e": "firebase emulators:exec --only functions,firestore,auth \"vitest run tests/e2e/01-login-create-commit.emulator.test.js tests/e2e/02-interno-pareja-scope.emulator.test.js tests/e2e/03-vde-pedido-y-roles.emulator.test.js tests/e2e/04-anon-y-sin-rol.emulator.test.js tests/e2e/05-waitlist-flujo.emulator.test.js tests/e2e/06-stock-changed.emulator.test.js --fileParallelism=false\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "audit:rules": "node scripts/audit-rules-coverage.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@firebase/rules-unit-testing": "^6.0.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.11.0",
    "fast-glob": "^3.3.2",
    "lighthouse": "^13.6.0",
    "mapshaper": "^0.8.8",
    "papaparse": "^5.7.1",
    "puppeteer-core": "^25.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "motion": "^13.1.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
