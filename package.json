{
  "name": "app-vendedores-shimano",
  "version": "0.0.0",
  "private": true,
  "description": "Shimano App Vendedores - build + test tooling (Fase 0). Deps por etapa para minimizar surface en cada install.",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "test:unit": "vitest run tests/unit/",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules/\"",
    "test:functions": "firebase emulators:exec --only functions,firestore,auth \"vitest run tests/functions/\"",
    "test:smoke": "playwright test tests/smoke/",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "audit:rules": "node scripts/audit-rules-coverage.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "esbuild": "^0.24.0",
    "fast-glob": "^3.3.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
