{
  "name": "app-vendedores-shimano",
  "version": "0.0.0",
  "private": true,
  "description": "Shimano App Vendedores - build + test tooling (Fase 0). Deps por etapa para minimizar surface en cada install.",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "test:unit": "vitest run tests/unit/",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules/\"",
    "test:functions": "firebase emulators:exec --only functions,firestore,auth \"vitest run tests/functions/\"",
    "test:smoke": "vitest run tests/smoke/",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "audit:rules": "node scripts/audit-rules-coverage.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@firebase/rules-unit-testing": "^5.0.2",
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.2",
    "lighthouse": "^13.4.1",
    "mapshaper": "^0.7.61",
    "papaparse": "^5.7.0",
    "puppeteer-core": "^25.11.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "motion": "^13.1.1"
  }
}
