{
  "name": "shimano-crm-backend-new",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL schema v0 + tests para CRM Shimano (ADR-001). Independiente del functions/ raiz.",
  "type": "module",
  "scripts": {
    "migrate:up": "node-pg-migrate up --migrations-dir db/schema --migration-file-language sql",
    "migrate:down": "node-pg-migrate down --migrations-dir db/schema --migration-file-language sql",
    "migrate:create": "node-pg-migrate create --migrations-dir db/schema --migration-file-language sql",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "node-pg-migrate": "^7.9.0"
  },
  "devDependencies": {
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
