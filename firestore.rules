rules_version = '2';

// Rules de app-vendedores-shimano.
// Baseline: `firestore.rules.baseline` (snapshot 2026-07-24 desde Console).
// Refactor Fase 0 (rama fase-0):
//   1. `list` de pedidos/visits/rendiciones para vendedor requiere
//      `resource.data.ownerUid == request.auth.uid`. Antes: cualquier
//      reader listaba todo → un vendedor con consola browser podía
//      enumerar visitas/pedidos/rendiciones de otros vendedores.
//      Ahora vendor solo lista sus propios docs. Admin/gerente/interno
//      no cambian (siguen viendo todo — necesario para panels).
//   2. Doc `app_config/sap_integration` (creds SAP): read restringido a
//      admin+gerente. Antes: cualquier reader (incluido viewer) leía
//      las creds. E5 lo elimina moviendo creds a Secret Manager en
//      Cloud Functions.
// Todo lo demás preserva la baseline. Suite de tests contra emulator
// en `tests/rules/` bloquea regresiones.

service cloud.firestore {
  match /databases/{database}/documents {

    function role() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role;
    }
    // v548: vendor name asignado al VDE (matchea POINTS[i].vendor y
    // client_applications.assignedVendor). null si no tiene.
    function myVendorKey() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.vendor;
    }
    function isAdmin() { return request.auth != null && role() == 'admin'; }
    function isViewer() { return request.auth != null && role() == 'viewer'; }
    function isVendor() { return request.auth != null && role() == 'vendedor'; }
    function isInterno() { return request.auth != null && role() == 'interno'; }
    function isGerente() { return request.auth != null && role() == 'gerente'; }
    function isAdminOrGerente() { return isAdmin() || isGerente(); }
    function isReader() { return isAdmin() || isViewer() || isVendor() || isInterno() || isGerente(); }
    function isSeguimientoUser() { return isAdmin() || isGerente() || isInterno(); }
    function ownsDoc() { return request.auth != null && resource.data.ownerUid == request.auth.uid; }

    function isMyPartnerVDE(targetUid) {
      return isInterno()
        && exists(/databases/$(database)/documents/roles/$(targetUid))
        && get(/databases/$(database)/documents/roles/$(targetUid)).data.role == 'vendedor'
        && get(/databases/$(database)/documents/roles/$(targetUid)).data.internalPartnerUid == request.auth.uid;
    }

    // Section MERCADOLIBRE (Mariano-only). Ver docs/specs/2026-09-18-mercadolibre-crm-section-design.md
    // HARDENING 6 F9-ITER-2 (2026-11-20): guard contra token sin email.
    // Antes: `request.auth.token.email in [...]` tiraba "Null value error"
    // cuando el token no traia email (tests con authedDb(uid) sin
    // tokenExtras, o cuentas anonimas con auth.uid pero sin email). Al ser
    // evaluada como primer branch de las OR (ej. roles.update C-hibrida S3+D18),
    // el error propagaba y Firestore devolvia PERMISSION_DENIED aunque el
    // segundo branch (admin no-Mariano) hubiera fallado tambien. Ahora el
    // guard `'email' in request.auth.token.keys()` es chequeo de existencia
    // de la key antes de hacer el `in [...]`, deja la expresion safe y
    // permite que el OR caiga al segundo branch con una condicion booleana.
    function isMariano() {
      // HARDENING 6 F9-ITER-2 (2026-11-20): safe check contra tokens sin
      // email. Antes: `request.auth.token.email in [...]` tiraba "Null value
      // error" / "Property email is undefined on object" cuando el token no
      // traia email (tests con authedDb(uid) sin tokenExtras). El patron
      // `'email' in request.auth.token` chequea existencia de la key en el
      // map safe antes del acceso al valor, previniendo "Property undefined".
      return request.auth != null
        && 'email' in request.auth.token
        && (
          request.auth.token.email == 'erbinomariano@gmail.com'
          || request.auth.token.email == 'mariano.erbino@shimano.com.ar'
        );
    }

    // v1420 §54 (2026-10-22): editores de Ficha Cliente opt-in. Usuarios con
    // `roles/{uid}.fichaClienteEditorFull == true` pueden escribir TODOS los
    // campos de la ficha (fidelidad, prefContacto, tamano, especializacion,
    // tipoLocal, cliTipo, creditoCheque) para CUALQUIER cliente, no solo los
    // de su zona. Habilitado para Ioannis Palkoudakis + Santiago Esteban
    // (role=interno). Admin/gerente ya tienen el permiso por isAdminOrGerente().
    //
    // v1501 §93 (2026-10-28): PACHI (role=vendedor) también editor opt-in de
    // Ficha Cliente. Reporte prod Mariano: PACHI no podía guardar los selects
    // (status "Error guardando: Missing or insufficient permissions") porque
    // `client_master.update` para isReader() exigía hasOnly(['defaultDelivery'])
    // y el autosave del modal escribe cliTipo/fidelidad/prefContacto/etc.
    // Fuente única de UIDs: src/pure/pachi-restrictions.js (PACHI_UIDS).
    // Los 2 UIDs son hardcoded acá porque las rules no pueden importar JS.
    // Si en el futuro cambia PACHI_UIDS, actualizar ambos lados.
    // - PACHI real: pachinaba@gmail.com, uid LaBFi1xkSLObzLEdRoP8fonZ06r2.
    // - Test user Playwright: pruebas.pachi@shimano.com.ar,
    //   uid tUJHiLDyLHWvbkpWgCQXWJcucfV2.
    // Esta regla es ortogonal a §93 (restricciones negativas PACHI): Ficha
    // Cliente NO está en PACHI_BLOCKED_OPEN_FNS ni en el set de botones ocultos
    // del sidebar — el perfilado comercial es una tarea legítima para PACHI.
    function isPachiUid() {
      return request.auth != null
        && (request.auth.uid == 'LaBFi1xkSLObzLEdRoP8fonZ06r2'
            || request.auth.uid == 'tUJHiLDyLHWvbkpWgCQXWJcucfV2');
    }
    // SEC-04 (P0, 2026-10-29): además del flag, exige un rol con lectura
    // (isReader). Un usuario unassigned con el flag ya no edita fichas.
    function isFichaClienteEditor() {
      return request.auth != null
        && isReader()
        && (
          isPachiUid()
          || (
            exists(/databases/$(database)/documents/roles/$(request.auth.uid))
            && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.fichaClienteEditorFull == true
          )
        );
    }

    // v1414 §51.1 (2026-10-22): whitelist especifica para el reporte
    // "Infracciones MELI (MAP)" del modal Reportes Excel. Mas amplio que
    // isMariano() porque Diego (dir Shimano UY) tambien necesita el reporte.
    // Mantener sincronizado con el gate client-side en
    // src/domains/exports-core.js (INFRACCIONES_MELI_READERS).
    function canReadInfraccionesMeli() {
      return request.auth != null
        && 'email' in request.auth.token
        && (
          request.auth.token.email == 'erbinomariano@gmail.com'
          || request.auth.token.email == 'mariano.erbino@shimano.com.ar'
          || request.auth.token.email == 'diego.valsi@shimano.uy'
        );
    }

    match /roles/{uid} {
      // Planner Task 2: agregado isMariano() para que onPlannerStageChanged CF
      // pueda leer roles/{uid}.email server-side al enviar notif VDI.
      // v1491 §89 cap 2 (2026-10-27): agregado resource.data.role=='vendedor'
      // para que cualquier user autenticado pueda listar los VDEs y resolver
      // vendorKey → UID client-side (`enrichPayloadWithClientVendor` →
      // `resolveClientVendorFromMaster`). Antes v1491 el VDE no podía leerlos
      // → `vdeUsers=[]` → payload sin assignedVendorUid → gate server
      // VENDOR_UID_MISSING rechazaba. Exposición: nombre + email de los VDEs
      // (datos ya conocidos internamente). Admin SDK (CFs) bypassa rules.
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || isAdmin()
        || isGerente()
        || isMariano()
        || resource.data.internalPartnerUid == request.auth.uid
        // D2 (2026-10-29): la lectura de docs de vendedores queda para roles
        // lectores (vendedor/interno/viewer/gerente/admin). Antes alcanzaba
        // con estar autenticado: un Gmail recién creado (role unassigned)
        // leía totpSecret/passwordHash de todos los VDEs. El caso de uso de
        // v1491 (VDE resuelve vendorKey→UID) lo hacen lectores. Los secretos
        // salen de `roles` en la migración D2 (ver auth_secrets abajo).
        || (isReader() && resource.data.role == 'vendedor')
      );
      // v917 (2026-09-14, SecAudit Sprint 0 CRIT-01): cerrar auto-escalation
      // admin. Antes: `role in ['unassigned','admin']` permitia que CUALQUIER
      // usuario autenticado se auto-promoviera a admin en su primer create.
      // Ahora: `admin` solo puede setearse en create si el token.email es la
      // cuenta bootstrap `bot.shimano.pesca@gmail.com`. Ver
      // `fetchAndApplyRole` en index.html:22212 (isBoot flow).
      // Promociones posteriores usan `update` que requiere isAdmin() (linea 66).
      // SEC-04 (P0, 2026-10-29): el create solo admite los 5 campos que
      // escriben los flujos legítimos de alta (index.html fetchAndApplyRole y
      // el alta de usuario no autorizado): email, displayName, role, vendor,
      // createdAt. Antes no había hasOnly() → una cuenta nueva podía crearse
      // su doc con fichaClienteEditorFull:true (u otros flags) y editar
      // cualquier ficha de client_master. vendor debe ser null (el vendor lo
      // asigna el admin vía update, que sigue siendo solo isAdmin()).
      allow create: if request.auth != null && request.auth.uid == uid
                     && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'vendor', 'createdAt'])
                     && (!('vendor' in request.resource.data) || request.resource.data.vendor == null)
                     && (
                       request.resource.data.role == 'unassigned'
                       || (
                         request.resource.data.role == 'admin'
                         && request.auth.token.email == 'bot.shimano.pesca@gmail.com'
                         // D3 (2026-10-29): exige email verificado y login con
                         // Google. Sin esto, una cuenta email/contraseña creada
                         // con ese email (no verificado) podía auto-crearse admin.
                         && request.auth.token.email_verified == true
                         && request.auth.token.firebase.sign_in_provider == 'google.com'
                       )
                     );
      // S04b PR-B (2026-11-04): congelamiento de credenciales legacy frente al
      // cliente. Los campos passwordHash/passwordSalt/totpSecret/totpEnabled
      // que PR-A todavía dual-writea en /roles (compat + rollback) ya NO pueden
      // ser creados, modificados ni eliminados por un update cliente — ni
      // siquiera por admin. Las Cloud Functions de PR-A los administran vía
      // Admin SDK, que OMITE estas reglas (su dual-write sigue intacto). El
      // resto de los campos administrativos sigue editable por admin. Las
      // reglas de read y create no se tocan (create ya los excluye por el
      // hasOnly de 5 campos de SEC-04). affectedKeys() cubre alta/edición/baja
      // de esos campos (una eliminación de campo también aparece en el diff).
      // HARDENING 6 F9 HARD6-F4-S3 + D18 (2026-11-20): C-hibrida en roles.update.
      // - Mariano (isMariano()): puede escribir cualquier campo (incluido
      //   fichaClienteEditorFull + internalPartnerUid). Es la persona que
      //   asigna partnership VDI<->VDE + habilita editores de ficha.
      // - Admin no-Mariano: NO puede escribir fichaClienteEditorFull (vector
      //   de escalada a Ficha Cliente cross-cliente) ni internalPartnerUid
      //   (hijack de partnership VDI, D18: un admin podia reasignar el
      //   partner VDI de un vendedor a si mismo y leer rendiciones ajenas).
      // - Ambos siguen bloqueados en S04b (passwordHash/salt/totpSecret/totpEnabled).
      allow update: if (isMariano()
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['passwordHash', 'passwordSalt', 'totpSecret', 'totpEnabled']))
                     || (isAdmin()
                         && !isMariano()
                         && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny([
                                'passwordHash', 'passwordSalt',
                                'totpSecret', 'totpEnabled',
                                'fichaClienteEditorFull',
                                'internalPartnerUid'
                              ]));
      allow delete: if isAdmin();
    }

    // D2 (2026-10-29): secretos del gate de contraseña y del TOTP. Solo Admin
    // SDK (Cloud Functions de verificación y del Panel Usuarios). Ningún
    // cliente lee ni escribe, ni siquiera el dueño o un admin: la verificación
    // ocurre en el servidor. Colección nueva, todavía sin datos (la migración
    // desde roles/{uid} requiere aprobación).
    match /auth_secrets/{uid} {
      allow read, write: if false;
    }

    match /userData/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isGerente() || isViewer());
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Pedidos: get (por id) abierto a reader; list restringido para vendedor a own.
    // SEC rules batch 2026-11-24 (ajuste #1375): VDE/VDI solo tocan
    // transferidoSAP en pedidos que nunca fueron a SAP. Permitido si:
    //   - el campo no cambia, o
    //   - el valor previo es nulo/ausente o via == 'app_only', Y el nuevo
    //     valor se borra (FieldValue.delete) o es via == 'app_only' sin docEntry.
    // Un pedido con cotizacion real en SAP (via distinto de app_only) no se
    // puede desmarcar ni reescribir desde el cliente; eso evita reenvios.
    function transferidoSapChangeIsAppOnly() {
      return !('transferidoSAP' in request.resource.data.diff(resource.data).affectedKeys())
        || (
          (resource.data.get('transferidoSAP', null) == null
            || resource.data.get(['transferidoSAP', 'via'], '') == 'app_only')
          && (
            !('transferidoSAP' in request.resource.data)
            || (
              request.resource.data.get(['transferidoSAP', 'via'], '') == 'app_only'
              && request.resource.data.get(['transferidoSAP', 'docEntry'], null) == null
            )
          )
        );
    }

    match /pedidos/{pedidoId} {
      allow get: if isReader();
      // v1406 §44 (2026-10-22): VDE list permite OR ownerUid=self (compat
      // pre-§44) OR assignedVendorUid=self (nuevo campo, Planner filtra ahí).
      // El filtro Firestore debe matchear uno de los dos para pasar.
      allow list: if isAdminOrGerente() || isInterno()
        || (isVendor() && (ownsDoc() || resource.data.assignedVendorUid == request.auth.uid));
      // v991 (2026-09-18, SecAudit run-1 HIGH #5): validar ownerVendor en
      // create. Antes: un VDE con devtools/curl podia crear un pedido con
      // `ownerUid=self` + `ownerVendor='<victim>'` -> trigger
      // onPedidoConfirmedSendToSap resolvia SlpCode del victim -> commission
      // fraud + audit trail confuso (Firestore muestra atacante, SAP muestra
      // victim). Ahora Rules validan que ownerVendor sea null / propio /
      // seteado por admin+gerente. La CF ademas hace fresh lookup a
      // roles/{ownerUid}.vendor (defensa en profundidad), pero cerrar el
      // create al nivel de rule ya bloquea el vector de fraude.
      // SEC rules batch 2026-11-24 (#1379 con ajuste): create directo solo
      // admin/gerente. Todo pedido de vendedor o interno nace en
      // commitPedidoCF (Admin SDK, no pasa por rules; §67 v1454 elimino el
      // pedidos.add del cliente). Cerrar el camino directo evita pedidos
      // creados fuera del servidor con datos (descuento, vendedor, estado)
      // que el servidor no valido.
      allow create: if isAdminOrGerente();
      // v747 (2026-08-31): relajada la rule de update/delete para internos.
      // Antes: internos solo podian update pedidos donde eran ownerUid
      // (onBehalfOf=false) o createdByUid (onBehalfOf=true). Bug reportado
      // por Santi (interno): al pasar un pedido de "lista de espera" a
      // "pendientes", el flow ASIG resolve (index.html:16685) hace batch
      // update sobre multiples pedidos de otros vendedores para cancelar/
      // reciclar sus lineas ASIG. Como interno no era owner de esos otros
      // pedidos, la batch fallaba con "Missing or insufficient permissions".
      // Ahora: internos pueden update cualquier pedido (blanket). Justificacion:
      // los 2 internos (Santi/Ioannis) estan en whitelist confiable, ya
      // pueden crear pedidos on-behalf-of vendedores, y necesitan poder
      // resolver ASIG lines cross-vendor para el flow waitlist. VDEs siguen
      // restringidos a sus propios pedidos.
      // v918 (2026-09-14, SecAudit Sprint 1 E1.3 HIGH-05 + CHAIN-01):
      // vendor update queda restringido a un whitelist de campos con
      // affectedKeys().hasOnly(). Antes no habia hasOnly -> VDE malicioso
      // podia editar transferidoSAP=null y confirmar el pedido de nuevo,
      // gatillando SQ duplicada en SAP + comision doble (CHAIN-01), o
      // tamperear netAmountArs/clientCardCode. Ahora los campos sensibles
      // (transferidoSAP, transferError, sendingSapLock, orderNumberPrev/*,
      // sapEstado*, ownerUid, ownerEmail, ownerVendor, key, tipo, etc)
      // solo pueden ser escritos por CFs (Admin SDK) o admin/gerente.
      //
      // Delete: cerrado para vendor (era abierto antes por ownership) —
      // un vendedor no deberia poder wipear su propio pedido confirmado.
      // Admin/gerente/interno siguen igual (v747 blanket para interno).
      // §63 (2026-10-23 v1442): CIERRE DEL PARCHE §61.
      //
      // §61 (v1440) abrio `pedidos.update` para VDE sin check de ownership
      // como parche de emergencia para que el flow waitlist/CPST
      // cross-vendor volviera a funcionar (Gonzalo bloqueado en ORDEN 516
      // BROBRO). Trade-off: VDE malicioso podia editar lines de otros.
      //
      // §63 cierra el parche:
      //   - Las 2 escrituras cross-vendor (§40.6 cliente_rechazo_cpst +
      //     §40.7 quitar producto con ASIG) pasan por `releaseAsigCF`
      //     server-side con validacion de permiso explicita (admin/gerente/
      //     interno OR ownerUid del waitlist OR assignedVendorUid del
      //     waitlist == auth.uid).
      //   - La rule vuelve a exigir ownerUid OR assignedVendorUid del VDE
      //     sobre el PROPIO pedido. Un VDE sin assignedVendorUid del cliente
      //     ya no puede update directo.
      //
      // Patron §44/§46/§59: assignedVendorUid viene del master del cliente;
      // el VDE del cliente puede update su pedido aunque la haya cargado
      // Pablo. Un VDE que NO es el assignedVendorUid (otro VDE) no puede
      // update aunque la haya visto en su sidebar (filtrado client-side
      // por §59 pero defensiva server-side via rule).
      // SEC-C1 (Fase 2B, 2026-11-18): VDI (`isInterno()`) tambien recibe
      // whitelist, identica al VDE (30 campos). El flow operativo del VDI
      // (Santi/Ioannis) toca los mismos campos que el VDE — pero puede
      // operar sobre pedidos AJENOS (sin ownerUid/assignedVendorUid check).
      // Antes del fix: blanket update habilitaba mutar transferidoSAP (CHAIN-01
      // commission fraud), assignedVendorUid (viola §44), orderNumberPrev,
      // netAmountArs, discountPct. Admin/gerente mantienen blanket (recovery
      // humano post-incidente).
      // SEC-C1 Opcion A.2 (2026-11-19):
      // whitelist extendida con 6 campos (transferidoSAP + 5 audit) + guard
      // semantico sobre transferidoSAP: solo permitido si via=='app_only'
      // (auto-confirm 100% BO legitimo) o si el campo se esta deleteando
      // (FieldValue.delete() tras revert). Bloquea CHAIN-01: via='sap_sl' o
      // 'service_layer' desde cliente. Cubre 3 flows pre-existentes rotos
      // en VDE+VDI post-whitelist original (H-01 auto-confirm 100% BO
      // index.html:39009, H-02 volverAPendientes app_only index.html:39936,
      // H-03 confirmarDefinitivo auto-split index.html:39509).
      allow update: if isAdminOrGerente()
        || (
          isInterno()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            // Delivery info (VDI edita logistica post-envio para el VDE)
            'formaEntrega', 'deliveryDetails',
            // Contenido del pedido
            // Sin discountPct/discountSnapshot: el descuento lo fija el servidor
            // al crear (mismo criterio que el VDE, #1401).
            'lines', 'netAmountArs', 'subtotalArs',
            'condicionPago',
            // Transiciones de estado (waitlist -> pending -> confirmed)
            'stage', 'confirmedAt', 'finalizedAt', 'closedAt',
            // Metadata del pedido
            'observaciones', 'notes', 'clientNotes', 'updatedAt', 'updatedBy',
            'month', 'monthIdx', 'year',
            // orderNumber: decision Mariano 2026-09-14 (Sprint 1 Q2)
            'orderNumber',
            // Planner Kanban
            'plannerStage', 'plannerHistory', 'plannerEmails',
            'plannerAttachments', 'paidStatus', 'paidAmount', 'paidToDate',
            // Sync SAP payments escribe desde CF syncSapPaymentsToApp
            'invoicedAmount', 'paidSyncedAt',
            // SEC-C1 Opcion A.2: transferidoSAP (con guard abajo, solo via=='app_only' o delete)
            'transferidoSAP',
            // Audit del revert (volverAPendientes app_only, index.html:39936-39947)
            'revertedFromConfirmedAt', 'revertedBy',
            'previousSapDocNum', 'previousSapDocEntryCancelled',
            // Audit del auto-split (confirmarDefinitivo preCheck, index.html:39509)
            'autoSplitByStock'
          ])
          // SEC-C1 Opcion A.2: guard semantico transferidoSAP solo via='app_only' o delete
          // (1) campo no modificado, OR (2) campo borrado (FieldValue.delete), OR
          // (3) campo con via='app_only'. Bloquea via='sap_sl' y variantes CHAIN-01.
          && transferidoSapChangeIsAppOnly()
        )
        || (
          isVendor()
          && (
            resource.data.ownerUid == request.auth.uid
            || resource.data.assignedVendorUid == request.auth.uid
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            // Delivery info (usuario cambia transportista/sucursal/retiro post-envio)
            'formaEntrega', 'deliveryDetails',
            // Contenido del pedido (edit lines pre-transfer, aggregate updates)
            // HARDENING6 (2026-11-23): 'discountPct' y 'discountSnapshot' fuera del
            // whitelist del VDE. El descuento se fija al crear el pedido (server-side);
            // ningun call-site del cliente lo actualiza despues. Si hiciera falta
            // editarlo post-create, hacerlo via CF dedicada con tope por rol + log
            // (pattern releaseAsigCF §63), no reabriendo este whitelist.
            'lines', 'netAmountArs', 'subtotalArs',
            'condicionPago',
            // Transiciones de estado (waitlist -> pending -> confirmed)
            'stage', 'confirmedAt', 'finalizedAt', 'closedAt',
            // Metadata del pedido
            'observaciones', 'notes', 'clientNotes', 'updatedAt', 'updatedBy',
            'month', 'monthIdx', 'year',
            // orderNumber: incluido por decision Mariano 2026-09-14 (Sprint 1 Q2)
            'orderNumber',
            // Planner Kanban (Task 2, 2026-09-22): etapa kanban + historial +
            // emails notif + adjuntos + estado/monto/fecha de pago.
            'plannerStage', 'plannerHistory', 'plannerEmails',
            'plannerAttachments', 'paidStatus', 'paidAmount', 'paidToDate',
            // Fase 2 v1035 (2026-09-22): sync SAP payments escribe estos
            // fields desde el CF syncSapPaymentsToApp cada 15min.
            'invoicedAmount', 'paidSyncedAt',
            // SEC-C1 Opcion A.2: transferidoSAP (con guard abajo, solo via=='app_only' o delete)
            'transferidoSAP',
            // Audit del revert (volverAPendientes app_only)
            'revertedFromConfirmedAt', 'revertedBy',
            'previousSapDocNum', 'previousSapDocEntryCancelled',
            // Audit del auto-split (confirmarDefinitivo preCheck)
            'autoSplitByStock'
          ])
          // SEC-C1 Opcion A.2: guard semantico transferidoSAP (ver comentario en isInterno arriba)
          && transferidoSapChangeIsAppOnly()
        );
      allow delete: if isAdminOrGerente() || isInterno();
    }

    match /campaigns/{campaignId} {
      allow read: if isReader();
      allow create, update, delete: if isAdminOrGerente();
    }

    // §64.3 (2026-10-25): draft locks para prevenir duplicados por doble-
    // click en commitPedidoCF. Solo escribe el Admin SDK (CF). Negado
    // completo para cualquier cliente (admin incluido) — no hay razón para
    // leer/escribir desde la UI. Si Mariano quiere auditar, usar Admin SDK
    // via script.
    match /pedido_draft_locks/{draftId} {
      allow read, write: if false;
    }

    // app_only_reconcile_locks (incidente Federico 2026-11-20, v1568+): lock
    // interno usado por reconcilePedidosAppOnlyCF para evitar que dos
    // corridas concurrentes del scheduler re-disparen el mismo pedido
    // app_only dos veces. Solo Admin SDK escribe/lee; cliente nunca toca.
    match /app_only_reconcile_locks/{pedidoId} {
      allow read, write: if false;
    }

    // Visits: mismo patrón que pedidos — vendor list solo own.
    match /visits/{visitId} {
      allow get: if isReader();
      allow list: if isAdminOrGerente() || isInterno() || (isVendor() && ownsDoc());
      allow create: if (isAdminOrGerente() || isVendor() || isInterno())
                       && request.resource.data.ownerUid == request.auth.uid
        || (isInterno()
            && request.resource.data.createdByUid == request.auth.uid
            && request.resource.data.onBehalfOf == true
            && isMyPartnerVDE(request.resource.data.ownerUid));
      allow update, delete: if isAdminOrGerente()
        || ((isVendor() || isInterno()) && resource.data.ownerUid == request.auth.uid)
        || (isInterno()
            && resource.data.createdByUid == request.auth.uid
            && resource.data.onBehalfOf == true);
    }

    match /operations_log/{logId} {
      allow read: if isAdmin() || isViewer();
      // A2.3 (SEC-M3 / SEC-NIGHT-R-06, 2026-11-19): hasOnly + guard userUid
      // + guard type contra falsificación de eventos privilegiados.
      //
      // Pre-A2.3: cliente podía crear log con `type='admin_override'` o
      // sembrar `userRole='admin'` para hacer appear que un admin autorizó
      // una acción. Post-A2.3:
      //   - hasOnly(whitelist): solo los campos que los call-sites reales
      //     escriben (inventario de call-sites, rehecho 2026-11-24).
      //   - userUid == auth.uid: preservado (no falsificar actor).
      //   - type: limitado al set CLIENT (5 types). Los types SERVER
      //     (bo_absorbed, commit_pedido_warning, pedido_deleted, etc.) solo
      //     los escribe Admin SDK bypassando rules.
      //
      // Set CLIENT (5 types permitidos):
      //   - 'asig_huerfana'                    (index.html orchestration)
      //   - 'commitPedidoCF_fallback_legacy'   (index.html diag)
      //   - 'client_confirm_exception'         (catch del commit flow)
      //   - 'client_write_failed'              (§70 defensa write logger)
      //   - 'export_failed'                    (exports-reparto.js)
      // Además `logOp()` del audit panel usa campos genéricos (action +
      // entityType) sin `type` — se permite si `type` NO está en el doc
      // (uso legacy del audit panel).
      allow create: if request.auth != null
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          // Identity
          'userUid', 'userEmail', 'userRole',
          // Timestamp
          'timestamp', 'createdAt',
          // Legacy audit panel shape (logOp)
          'action', 'entityType', 'entityName', 'details',
          // Discriminated type (CLIENT set validado abajo)
          'type',
          // Contexto compartido
          'sku', 'pedidoId', 'lineIndex', 'motivo',
          'lineState', 'lineQtyOpen', 'qtyEsperada', 'qtyFaltanteSku',
          'clientName', 'cardCode', 'orderNumber', 'orderKey',
          'waitlistOrigenId', 'draftId', 'via', 'appVersion',
          'clientVersion',
          // client_confirm_exception
          'errStack', 'code', 'email',
          // client_write_failed (§70)
          'collection', 'documentId', 'errMessage', 'errCode',
          'op', 'handler', 'clientCardCode', 'batchRefsCount',
          // Ajuste batch 2026-11-24: commitPedidoCF_fallback_legacy escribe
          // firebaseCode + skus; export_failed (exports-reparto.js) escribe
          // exportKind + error. Faltaban en #1381.
          'firebaseCode', 'skus', 'exportKind', 'error'
        ])
        && (
          !('type' in request.resource.data)
          || request.resource.data.type in [
            'asig_huerfana',
            'commitPedidoCF_fallback_legacy',
            'client_confirm_exception',
            'client_write_failed',
            'export_failed'
          ]
        );
      allow update, delete: if false;
    }

    // v1171 (2026-10-07): snapshot historico diario de stock escrito por
    // send_stock_snapshot_email.py (cron L-V 16:00 ART). Read admin+gerente+
    // viewer para dashboards futuros; write solo via Service Account (bypass).
    match /stock_daily_snapshots/{docId} {
      allow read: if isAdmin() || isAdminOrGerente() || isViewer();
      allow write: if false;
    }

    match /sap_clients/{docId}  { allow read: if isReader(); allow write: if isAdminOrGerente(); }
    match /sap_products/{docId} { allow read: if isReader(); allow write: if isAdminOrGerente(); }
    match /sap_vendors/{docId}  { allow read: if isReader(); allow write: if isAdminOrGerente(); }

    match /route_overrides/{docId} {
      allow read: if isReader();
      allow create: if (isAdminOrGerente() || isVendor()) && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if isAdminOrGerente();
    }

    match /vendor_overrides/{docId} {
      allow read: if isReader();
      allow write: if isAdminOrGerente();
    }

    match /custom_routes/{docId} {
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid || isAdminOrGerente()
      );
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid || isAdminOrGerente()
      );
    }

    match /notifications/{docId} {
      allow read: if request.auth != null && (
        resource.data.targetUid == request.auth.uid
        || resource.data.fromUid == request.auth.uid
        || isAdmin() || isGerente()
      );
      // A2.2 (SEC-M2 / SEC-NIGHT-R-04, 2026-11-19): hasOnly + guard sobre
      // `fromUid` para que un usuario autenticado NO pueda sembrar
      // notifications con campos fuera del shape legitimo (ej. inyectar
      // `type='admin_override'` + payload confuso al targetUid).
      //
      // Whitelist derivada del inventario de los call-sites del cliente
      // (re-inventariado 2026-11-24: 15 add + 9 update): creator +
      // 2 target + 6 content + 11 payload + 4 state + 8 handler-specific
      // (approvedBy, rejectedBy, derivedToUid, etc.). Server-side (CFs Admin
      // SDK) bypassa rules.
      //
      // Guard: `fromUid == auth.uid` ya preservado (no cambia). Un VDE sigue
      // pudiendo crear notifs pero no puede falsificar remitente.
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          // Creator
          'fromUid', 'fromEmail', 'fromName', 'fromDisplayName',
          'createdByUid', 'createdByEmail',
          // Target
          'targetUid', 'targetEmail',
          'derivedToUid', 'derivedToEmail',
          // Content
          'type', 'subtype', 'title', 'body', 'message', 'description',
          // Payload / metadata
          'tienda', 'localidad', 'provincia', 'vendor', 'mes', 'anio',
          'clientName', 'rendicionId', 'pedidoId',
          'minutesInPending', 'ageMinutes', 'relatedTaskId',
          // Ajuste batch 2026-11-24: campos que escriben hoy las altas de
          // clientes (applicationId, comercio) y las tareas con fotos
          // (images, targetName). Faltaban en #1380.
          'applicationId', 'comercio', 'images', 'targetName',
          // Approval flow (rendiciones)
          'approvedBy', 'approvedByEmail',
          'rejectedBy', 'rejectedByEmail',
          // State (presente al crear: valores iniciales)
          'status', 'read',
          // Server-only (tolerado si el cliente lo manda, pero realmente lo
          // escribe el server). No bloquea porque es serverTimestamp inocuo.
          'createdAt'
        ]);
      // A2.2 UPDATE: solo el target puede marcar estado + solo campos state.
      // Pre-A2.2 el update era blanket sobre todo el doc — un target
      // malicioso podia reescribir `title`, `body`, `type` del doc + cambiar
      // `targetUid` a otro user para "ocultar" la notif. Ahora cerrado a 3
      // campos de estado (`status`, `doneAt`, `readAt`).
      allow update: if request.auth != null
        && resource.data.targetUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'doneAt', 'readAt', 'read']);
      allow delete: if isAdminOrGerente()
        || (request.auth != null && resource.data.targetUid == request.auth.uid);
    }

    match /targets/{docId} {
      allow read: if isReader();
      allow create, update: if isAdminOrGerente();
      allow delete: if isAdminOrGerente();
    }

    // v367+ (2026-07-30): sap_snapshot es escrito SOLO por el service account
    // del cron sync_sap_to_bigquery.py (via Firebase Admin SDK, que bypassea
    // Rules). Los usuarios web solo leen; el filtro por vendedor se aplica
    // client-side via getMyAllowedVendorKeys() en dashboard.js.
    match /sap_snapshot/{docId} {
      allow read: if isReader();
      allow write: if false;
    }

    // v398+ (2026-08-05): backorder_snapshot escrito por el cron
    // sync_sap_to_bigquery.py (BQ v_backorder_lineas -> Firestore).
    // 1 doc por vendedor con array `lines` de SQ pendientes de despacho.
    // Uso: nueva tab BACKORDERS de la app.
    // Vendedores leen solo el suyo (filtro client-side); admin/gerente/interno
    // pueden leer todos.
    match /backorder_snapshot/{docId} {
      allow read: if isReader();
      allow write: if false;
    }

    // v42x+ (2026-08-06): sku_ventas_snapshot escrito por el cron
    // sync_sap_to_bigquery.py (BQ v_ventas_lineas ventana 13m -> Firestore).
    // 1 doc por SKU (~755) con map `meses` YYYY-MM -> {qty, ars} + familia/subfamilia.
    // Uso: modal FORECAST (src/domains/forecast.js) admin-only. Solo admin lee
    // porque son datos crudos de venta por SKU (competitivamente sensibles);
    // no hay razon para exponerlos a vendedores o viewers.
    match /sku_ventas_snapshot/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // v1098+ (2026-09-29) Fase 1 Forecast v2: cache del parseo de los 3 Sales
    // Plans mensuales (Rods/Reels/FG). 1 doc por familia (id = 'rods'|'reels'|'fg')
    // con las filas parseadas del Excel + metadata (uploadedBy, sourceFilename,
    // storagePath, detectedMonths, rowsCount). Escritos client-side desde
    // src/domains/forecast.js:onSalesPlanFileForFamilia() al hacer upload.
    // Mariano-only por diseño (feature admin-only). El Excel original vive en
    // Firebase Storage bajo `forecasts_snapshots/{YYYY-MM}/{familia}.xlsx`
    // (regla espejo en storage.rules).
    match /sales_plan_cache/{familia} {
      allow read: if isMariano();
      allow write: if isMariano()
                    && familia in ['rods', 'reels', 'fg'];
    }

    // v1099+ (2026-09-30) F2A.4 Forecast output — pipeline Python
    // scripts/forecast/train_prod.py + publish_to_firestore.py escribe
    // 1 doc por subfamilia con { forecast: [{ds, y_hat, lo80, hi80}],
    // metrics: {wape, bias, mae, rmse}, bestModel, versionId }.
    // Consumido por modal FORECAST (Mariano-only). WAPE mediano en
    // backtest: 0.476 (24 subfamilias) al 2026-09-30.
    match /forecast_output/{subfamiliaSlug} {
      allow read: if isMariano();
      allow write: if isMariano();
    }
    match /forecast_output_meta/{docId} {
      allow read: if isMariano();
      allow write: if isMariano();
    }

    // v1112+ (2026-09-30) F3B: config del modulo Forecast — SKUs descontinuados,
    // multiplicadores por subfamilia, etc. Mariano-only read+write.
    match /forecast_config/{docId} {
      allow read: if isMariano();
      allow write: if isMariano();
    }

    match /client_locations/{docId} {
      allow read: if isReader();
      allow create: if isAdminOrGerente() || isVendor() || isInterno();
      allow update, delete: if isAdminOrGerente();
    }

    match /client_master/{docId} {
      allow read: if isReader();
      // v785+ (2026-09-04): cualquier reader puede crear/updatear SOLO el
      // campo `defaultDelivery` (persistencia de datos de entrega por cliente,
      // pedido Mariano: reducir friccion vendedores). La v630 tenia el codigo
      // client-side (index.html:24007) pero fallaba silencioso para VDEs
      // porque esta rule solo permitia admin/gerente. Los demas campos
      // (address, addressExplicit, cliTipo, etc) siguen restringidos.
      // v926 (2026-09-14, SecAudit Sprint 1 E1.5 HIGH-08): shape validation.
      // Antes: defaultDelivery aceptaba cualquier JSON — VDE hostil podia
      // escribir string 10 MB, array anidado, o markup con XSS payload si
      // algun render lo interpreta como HTML. Ahora: is map, size<=12 keys
      // (Mariano OK 2026-09-14), y keys.hasOnly() con los sub-campos
      // esperados por saveDefaultDelivery + _saveDefaultDeliveryFromWaitlist
      // (index.html: tipo, transpNombre/Direccion, sucursalDireccion,
      // retiroNombre/Apellido/Dni/Patente, clienteDireccion + updatedAt/By).
      // v1420 §54: Ficha Cliente editor opt-in. Users con el flag
      // fichaClienteEditorFull=true en su rol pueden crear/updatear cualquier
      // campo de la ficha (como admin/gerente), para cualquier cliente.
      allow create: if isAdminOrGerente()
        || isFichaClienteEditor()
        || (isReader()
            && request.resource.data.keys().hasOnly(['defaultDelivery'])
            && request.resource.data.defaultDelivery is map
            && request.resource.data.defaultDelivery.size() <= 12
            && request.resource.data.defaultDelivery.keys().hasOnly([
              'tipo', 'deliveryMethod',
              'transpNombre', 'transportistaNombre',
              'transpDireccion', 'transportistaDireccion',
              'sucursalDireccion',
              'retiroNombre', 'retiroApellido', 'retiroDni', 'retiroPatente',
              'clienteDireccion',
              'updatedAt', 'updatedBy'
            ]));
      allow update: if isAdminOrGerente()
        || isFichaClienteEditor()
        || (isReader()
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['defaultDelivery'])
            && request.resource.data.defaultDelivery is map
            && request.resource.data.defaultDelivery.size() <= 12
            && request.resource.data.defaultDelivery.keys().hasOnly([
              'tipo', 'deliveryMethod',
              'transpNombre', 'transportistaNombre',
              'transpDireccion', 'transportistaDireccion',
              'sucursalDireccion',
              'retiroNombre', 'retiroApellido', 'retiroDni', 'retiroPatente',
              'clienteDireccion',
              'updatedAt', 'updatedBy'
            ]));
      // v778+: cualquier reader puede borrar la direccion guardada de un
      // cliente (limpieza colaborativa desde Master Clientes-Direcciones).
      // Solo borra client_master (address del cliente), NO borra el cliente
      // del padron POINTS ni del BP en SAP. Restringido a isReader() para
      // que solo cuentas autenticadas del equipo lo puedan hacer.
      allow delete: if isReader();
    }

    // v934 (2026-09-14, SecAudit Sprint 2 MED-05 VULN-208): split get/list.
    // Antes: `read` (get + list) abierto a cualquier authenticated - un user
    // unassigned podia enumerar TODOS los emails whitelisteados (staff
    // directory dump). Se usa como pretexto para phishing dirigido.
    // Ahora: get (por email como docId) sigue abierto - flujo login legitimo
    // en index.html:21457 y 21646 (check "estoy en la whitelist?"). List
    // (colecccion entera) restringido a admin+gerente.
    match /allowed_emails/{docId} {
      // Lote B (batch 2026-11-24): el login (isUserAllowed, index.html) lee
      // este doc ANTES de tener rol, asi que no puede exigir isReader(). Lo
      // minimo: un usuario sin rol solo puede leer el doc de SU propio email
      // (mismo id que emailToDocId: lower + trim + no-alfanumerico -> '_').
      // Ya no sirve para probar si un email ajeno esta habilitado.
      allow get: if isReader()
        || (request.auth != null
            && 'email' in request.auth.token
            && request.auth.token.email is string
            && docId == request.auth.token.email.lower().trim().replace('[^a-z0-9]', '_'));
      allow list: if isAdminOrGerente();
      allow write: if isAdmin();
    }

    match /client_applications/{docId} {
      // v548: restringir visibilidad de leads/altas a VDE por assignedVendor.
      // Antes: cualquier isReader() veia TODOS los docs (VDE veian leads
      // sin asignar + leads de otros VDEs). Ahora:
      //   - admin/gerente/viewer/interno: ven todo (backward compat).
      //   - vendedor: ve solo si assignedVendor == su vendor key OR fue
      //     creador del doc (ownerUid, necesario para tab "Mis solicitudes"
      //     en notificaciones.js:113 que query .where('ownerUid','==',uid)).
      // Interno (VDI) queda con acceso amplio server-side; filtro por
      // partner-vendors se hace client-side en getMyAllowedVendorKeys().
      // Full enforcement server-side de interno requeriria denormalizar
      // partner list en roles/{uid} — TODO post-v548.
      allow read: if isAdminOrGerente() || isViewer() || isInterno()
                   || (isVendor() && (
                        resource.data.assignedVendor == myVendorKey()
                        || resource.data.ownerUid == request.auth.uid
                      ));
      // v991 (2026-09-18, SecAudit run-1 HIGH #6): validar assignedVendor en
      // create. Antes: un VDE con devtools/curl podia crear alta rapida con
      // `assignedVendor='<victim>'` -> el lead aparecia en el mapa del victim
      // (`.where('assignedVendor','==',victimKey)`) mientras el ownerUid
      // seguia siendo el atacante. Simetrico a v926 HIGH-09 (update-side ya
      // cerrado). Ahora create solo permite: null (deja unassigned), propio
      // vendor, o admin+gerente overrides. Formulario publico
      // (submittedByPublicForm) sigue permitido sin auth para el flow web
      // externo.
      // HARDENING 6 F9 D1-H1 (2026-11-20): validar status en create auth.
      // Antes: el create autenticado aceptaba cualquier valor de status
      // (approved, rejected, custom) -> un VDE podia auto-aprobar un alta
      // saltando el flow admin. Ahora: status DEBE existir y estar en
      // {pending_approval, approved}. 'approved' solo admin/gerente, o el
      // alta rapida del vendedor (source alta_rapida + manualSapPending).
      allow create: if (
                   request.auth != null
                   && request.resource.data.ownerUid == request.auth.uid
                   && (
                     !('assignedVendor' in request.resource.data)
                     || request.resource.data.assignedVendor == null
                     || request.resource.data.assignedVendor == myVendorKey()
                     || isAdminOrGerente()
                   )
                   && request.resource.data.status in ['pending_approval', 'approved']
                   && (
                     request.resource.data.status == 'pending_approval'
                     || isAdminOrGerente()
                     // Alta rapida del vendedor (notificaciones.js submitAltaRapida):
                     // nace 'approved' pero marcada para carga manual en SAP.
                     || (request.resource.data.get('source', '') == 'alta_rapida'
                         && request.resource.data.get('manualSapPending', false) == true)
                   )
                 )
                 // v1172 (audit 2026-10-07, Security C-01): endurecer public form.
                 // Antes: cualquier unauthenticated podia crear docs multi-MB con
                 // base64 photos (constanciaArca, fotosLocal[]) sin size cap ni
                 // field whitelist. Vector DoS + storage exhaustion.
                 // Ahora: size <1.5MB + CUIT regex (11 digitos AR) + comercio length
                 // razonable. Fotos deberian subirse a Storage con signed URL, no
                 // embebidas en Firestore — pero mantenemos tolerancia hasta migrar.
                 || (request.resource.data.submittedByPublicForm == true
                     && request.resource.data.comercio is string
                     && request.resource.data.comercio.size() > 2
                     && request.resource.data.comercio.size() < 200
                     && request.resource.data.cuit is string
                     && request.resource.data.cuit.matches('[0-9]{11}')
                     && request.resource.data.status == 'pending_approval'
                     && request.resource.size() < 1500000);
      // v396 (2026-08-04): permitir a cualquier reader (vendedor incluido)
      // updatear SOLO los campos de estado del LEAD (leadEstado + auditoria).
      // Los demas campos siguen restringidos a admin/gerente/interno.
      // v776 (2026-09-02): fix bug reportado por Mariano — vendedores tocaban
      // "Editar direccion" (openSapAltaAddressModal en index.html:7785, con
      // comentario "v342+: vendedores + interno pueden editar direccion +
      // localidad") pero al confirmar Firestore rechazaba porque la whitelist
      // no incluia esos campos. Ahora extiendo la whitelist con los campos
      // que el flow de editar direccion + geocoding escribe:
      //   calle, localidad, localidadFinal, lat, lng, geoDisplay,
      //   geoPrecision, geoProvider, geoAt, updatedBy.
      // Restos (comercio, titular, cuit, cardCodeSap, precaucion*) siguen
      // restringidos a admin/gerente/interno.
      // v859 (2026-09-09): fix bug reportado por Gonzalo — apretar Guardar en
      // modal Alta SAP (saveSapAltaFantasiaFromModal) escribe `fantasia` pero
      // no estaba en la whitelist → "Missing permissions" a VDE. Agrego
      // `fantasia` (consistente con el UI v342+ que ya la deja editable a
      // todos). precaucion/precaucionReason siguen restringidos (admin-only)
      // — el cliente-side v859 ahora los omite del payload si el input no
      // esta en el DOM (VDE nunca los ve).
      // v926 (2026-09-14, SecAudit Sprint 1 E1.6 HIGH-09): scope el update
      // por vendor a sus propios leads. Antes: cualquier reader (incluidos
      // VDE de otra zona) podia togglear leadEstado, tamperear geo, forjar
      // leadEstadoBy de leads asignados a OTROS VDEs. La read rule ya scopea
      // por assignedVendor pero update no lo hacia. Ahora vendor solo puede
      // update si es el assignedVendor del lead o el owner del doc, Y si
      // toca leadEstadoBy el valor debe ser SU token.email (no forjable).
      allow update: if isAdminOrGerente() || isInterno()
                     || (isReader()
                         && (
                           // Vendor scope: solo leads suyos o donde es owner.
                           // Admin/gerente/viewer/interno ya cayeron arriba,
                           // asi que esto solo aplica a vendor + viewer.
                           // viewer no tiene vendorKey -> este check falla
                           // (esperado: viewer no deberia editar leads).
                           resource.data.assignedVendor == myVendorKey()
                           || resource.data.ownerUid == request.auth.uid
                         )
                         && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly([
                              'leadEstado', 'leadEstadoAt', 'leadEstadoBy',
                              'calle', 'localidad', 'localidadFinal',
                              'lat', 'lng',
                              'geoDisplay', 'geoPrecision', 'geoProvider', 'geoAt',
                              'fantasia',
                              'updatedAt', 'updatedBy'
                            ])
                         // Si tocan leadEstadoBy o updatedBy, deben coincidir
                         // con SU email/uid (defensa contra impersonation en
                         // el audit trail visible para gerentes).
                         && (
                           !(request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['leadEstadoBy']))
                           || request.resource.data.leadEstadoBy == request.auth.token.email
                         )
                         && (
                           !(request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['updatedBy']))
                           || request.resource.data.updatedBy == request.auth.uid
                           || request.resource.data.updatedBy == request.auth.token.email
                         ));
      // v778+: cualquier reader puede borrar un provisorio (client_applications
      // sin cardCodeSap) desde Master Clientes-Direcciones. Antes solo el
      // owner o admin/gerente. Ahora VDE/VDI pueden limpiar duplicados de
      // Alta Rapida sin depender del admin. Docs con cardCodeSap (BPs SAP
      // ya cargados) siguen protegidos: solo admin/gerente los borra para
      // evitar dejar pedidos huerfanos.
      allow delete: if isAdminOrGerente()
        || (isReader()
            && (!('cardCodeSap' in resource.data) || resource.data.cardCodeSap == null));
    }

    // Rendiciones: mismo patrón — vendor list solo own.
    // v857 (2026-09-09): anti-duplicados. Guard en update para impedir que
    // un doc marcado como 'duplicado_detectado' (por CF onCreate) pase a
    // 'approved' desde la UI. Admin/gerente igual puede pasar el status a
    // 'rejected' si quiere descartarlo.
    // v934 (2026-09-14, SecAudit Sprint 2 MED-13 VULN-707): cerrar el 2-step
    // bypass. El comment previo sugeria "cambiar status a pending_approval
    // primero y despues aprobar" para reactivar un falso positivo - pero eso
    // permitia admin/gerente aprobar una rendicion duplicada real en 2 ticks.
    // El CF detector solo corre onCreate, no re-evalua on update. Ahora una
    // vez marcada como duplicado_detectado el unico status transition
    // permitido es -> 'rejected' (admin cancelar el doc). Para un falso
    // positivo legitimo, el flow correcto es delete + create nueva desde 0.
    // v992 (2026-09-18, SecAudit run-1 CRITICAL #2): cap importe defensivo.
    // Antes: create/update aceptaba cualquier importe (inclusive 999999999
    // fruto de un Gemini adversarial). La CF ya valida el output del OCR y
    // rechaza si supera 10M ARS, pero un submit directo desde devtools/curl
    // bypasseando el OCR podia igual escribir el importe abusivo. Ahora las
    // rules exigen: si el campo `importe` esta presente y no es null, debe
    // ser numeric >= 0 y <= 10.000.000 (mismo cap que gemini-ocr-core.js).
    // El importe puede estar null en solicitudes borrador o algunos flows
    // legacy — permitimos absent/null.
    function _importeValido(imp) {
      return imp == null || (imp is number && imp >= 0 && imp <= 10000000);
    }
    match /rendiciones/{docId} {
      allow get: if isReader();
      allow list: if isAdminOrGerente() || isInterno() || (isVendor() && ownsDoc());
      allow create: if request.auth != null
                     && request.resource.data.ownerUid == request.auth.uid
                     && _importeValido(request.resource.data.get('importe', null))
                     && _importeValido(request.resource.data.get('importeUsd', null));
      allow update: if isAdminOrGerente()
                    && _importeValido(request.resource.data.get('importe', null))
                    && _importeValido(request.resource.data.get('importeUsd', null))
                    && (
                      // Path A: no era duplicado_detectado - update normal
                      resource.data.get('status', '') != 'duplicado_detectado'
                      || (
                        // Path B: era duplicado_detectado - solo permitir
                        // que status siga siendo 'duplicado_detectado' (edicion
                        // de otros campos) o pase a 'rejected' (cancelar doc).
                        request.resource.data.status == 'duplicado_detectado'
                        || request.resource.data.status == 'rejected'
                      )
                    );
      allow delete: if isAdminOrGerente();
    }

    // app_config: doc-specific overrides.
    // - sap_integration: contiene creds SAP → SOLO admin+gerente (los únicos
    //   que envían pedidos vía SL desde browser). E5 mueve las creds a
    //   Secret Manager y esta rule podrá cerrarse aún más.
    // - v551: gemini también cerrado a admin+gerente. Antes era isReader()
    //   (todos los @shimano leían la API key). Ahora la key vive en Secret
    //   Manager (Cloud Function geminiOcrProxy) y el doc en Firestore queda
    //   como legacy vacío. Cerrar la rule evita que un doc con key vieja/
    //   duplicada sea legible por un VDE. Post-deploy borrar el doc entero.
    // - resto (google_maps, price_list*, product_catalog_meta,
    //   stock_snapshot, users_directory): reader (todos necesitan).
    match /app_config/{docId} {
      // v542 E2: sap_sync_state es info operativa del sync SAP Invoices ->
      // pedidos-app. Solo admin/gerente para no exponer cursores/estado a
      // vendedores que no la necesitan.
      // E3 stock_snapshot_shadow_v3: shadow del snapshot app-source, admin/gerente
      // (info operacional del sync, no relevante a vendedores hasta cutover E5).
      allow read: if (docId in ['sap_integration', 'sap_sync_state', 'stock_snapshot_shadow_v3', 'gemini'] && isAdminOrGerente())
                  || (!(docId in ['sap_integration', 'sap_sync_state', 'stock_snapshot_shadow_v3', 'gemini', 'planner_responsables', 'planner_config']) && isReader())
                  // Lote B (batch 2026-11-24): planner_config y feature_flags
                  // solo para roles aprobados (antes: cualquier logueado).
                  || (docId == 'planner_config' && isReader())
                  || (docId == 'planner_responsables' && (isAdmin() || isGerente() || isMariano()));
      // Planner Task 2: planner_responsables y planner_config tienen su propio
      // gate de write (isMariano-only). El catch-all `isAdmin()` queda excluido
      // para esos dos docIds para evitar bypass de la restriccion Mariano-only.
      allow write: if isAdmin() && !(docId in ['planner_responsables', 'planner_config', 'feature_flags']);
    }

    // Planner Kanban Task 2 (2026-09-22): configuracion de responsables del
    // planner. Solo Mariano puede escribir; admin/gerente/Mariano pueden leer.
    match /app_config/planner_responsables {
      allow read: if isAdmin() || isGerente() || isMariano();
      allow write: if isMariano();
    }

    // v1562 reparto-dep12 §E4.1: feature flags runtime. Cualquier usuario
    // autenticado lee (necesario para que los clientes resuelvan el estado
    // del flag). Solo Mariano puede escribir desde el Panel de Control.
    match /app_config/feature_flags {
      allow read: if isReader();
      allow write: if isMariano();
    }

    // Planner Kanban Task 2 (2026-09-22): configuracion general del planner
    // (etapas, columnas, labels). Cualquier usuario autenticado puede leer
    // para renderizar el tablero. Solo Mariano puede configurarlo.
    match /app_config/planner_config {
      allow read: if isReader();
      allow write: if isMariano();
    }

    // v913 (2026-09-13): contador atomico para reservar orderNumber en
    // pedidos. Reemplaza el max(revisionWaitlist)+1 client-side que colisiono
    // en produccion (ORDEN 131 y 144 duplicadas). Solo un doc valido:
    // 'orderNumber'. Monotonicidad enforceada: value solo puede crecer, nunca
    // retroceder. Read abierto a isReader (necesario para la transaccion).
    // v933 (2026-09-14, SecAudit Sprint 2 MED-04 VULN-207): cap increment
    // + hasOnly. Antes: cualquier reader podia jumpear el counter a
    // Number.MAX_SAFE_INTEGER (starving legit order numbers para siempre)
    // o inyectar campos extra al doc que otros consumers pudieran honrar.
    // Ahora: value nuevo <= viejo+1 (una unidad por request) + hasOnly.
    // El reserveNextOrderNumber (index.html) hace exactly value+1 asi que
    // el cap es tight - no false positive.
    match /counters/{docId} {
      allow read: if isReader();
      allow create: if isReader()
                     && docId == 'orderNumber'
                     && request.resource.data.keys().hasOnly(['value', 'updatedAt', 'seededAt', 'seededReason'])
                     && request.resource.data.value is int
                     && request.resource.data.value > 0
                     && request.resource.data.value <= 1000000;
      allow update: if isReader()
                     && docId == 'orderNumber'
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['value', 'updatedAt'])
                     && request.resource.data.value is int
                     && request.resource.data.value > resource.data.value
                     && request.resource.data.value <= resource.data.value + 1;
      allow delete: if false;
    }

    // v939 (2026-09-14, SecAudit Sprint 2 MED-15 VULN-L004): counters de
    // rate limit escritos por CF (Admin SDK bypass rules). Owner puede
    // leer su propio doc para debug (ver "cuanto uso me queda?" en la
    // proxima ventana), admin/gerente pueden leer cualquiera para
    // monitoring. Nadie puede escribir client-side - el counter es solo
    // server-side.
    match /rate_limits/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdminOrGerente());
      allow write: if false; // solo CF via Admin SDK
    }

    // v542 E2: audit log del sync SAP Invoices. Escrito por Cloud Function
    // (Admin SDK, bypass rules). Lectura para admin/gerente (monitoring).
    match /sap_sync_log/{logId} {
      allow read: if isAdminOrGerente();
      allow write: if false; // solo CF via Admin SDK
    }

    // v544 E4.5: audit log del FIFO auto-assign BO->ASIG. ELIMINADO v1279.
    // La CF `onStockChangeFIFOAssign` ya no existe (reemplazado por
    // reparto manual via `onDep11IncreaseCreateReparto` + modal "Reparto").
    // Los docs historicos de stock_assignment_log* quedan en Firestore pero
    // sin reglas de lectura — admin accede via Firebase Console si necesita.

    // v561 E7 TTL: audit log de expiraciones diarias de ASIG > 30d.
    // Escrito por CF expireAsigLinesTTLCF (Admin SDK). Lectura admin/gerente.
    match /asig_ttl_log/{logId} {
      allow read: if isAdminOrGerente();
      allow write: if false;
    }

    // v1277 (2026-10-14): reparto manual por Pablo.
    // ingresos_reparto: creado por CF onDep11IncreaseCreateReparto cuando sube
    //   stock dep 11 (via Admin SDK). admin/gerente lee para mostrar en modal.
    //
    // v1323 (2026-10-15): permitir admin/gerente update de campos especificos
    // desde el cliente (NO el reparto efectivo — eso sigue via CF):
    //   - clientesBO + clientesCount + qtyBackorderTotal + clientesBOLiveUpdatedAt:
    //     snapshot refresh v1317 (actualizar clientes LIVE antes de aplicar).
    //   - status + appliedAt + appliedBy + closureReason:
    //     bulk "procesar obsoletos" v1320 (marcar status=done sin reparto).
    // create/delete siguen bloqueados — los docs solo nacen via CF trigger.
    // El reparto efectivo (write a pedidos.lines) sigue via CF applyRepartoManualCF.
    match /ingresos_reparto/{ingresoId} {
      allow read: if isAdminOrGerente();
      allow update: if isAdminOrGerente()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'clientesBO', 'clientesCount', 'qtyBackorderTotal', 'clientesBOLiveUpdatedAt',
               'status', 'appliedAt', 'appliedBy', 'closureReason'
             ]);
      allow create, delete: if false;
    }

    // v1277: audit log por aplicacion de reparto. Escrito por CF (Admin SDK).
    match /reparto_log/{logId} {
      allow read: if isAdminOrGerente();
      allow write: if false;
    }

    // v1329 (2026-10-15): Target Altas — VDI (Santiago/Ioannis) marcan
    // clientes dados de alta en SAP por mes. docId = VENDOR_YYYYMM.
    // - Admin/gerente/interno: read all + write (editar cualquier vendor).
    // - VDI (interno con vendor Santiago/Ioannis): puede read all + solo
    //   escribir su propio doc (resource.data.vendor matchea su vendorKey).
    // Nota: usamos resource.data.vendor en vez de parsear el docId para
    // simplificar y permitir migrar formato del ID sin cambiar rules.
    match /vdi_target_altas/{docId} {
      allow read: if isAdminOrGerente() || isInterno() || isVendor();
      allow write: if isAdminOrGerente() || isInterno();
    }

    // v1278 (2026-10-14): audit log one-shot de la migracion ASIG→BO +
    // creacion de ingresos_reparto. Escrito por CF migrateAsigToBOCF.
    match /asig_migration_log_v1278/{logId} {
      allow read: if isAdminOrGerente();
      allow write: if false;
    }

    // v1280 (2026-10-14): audit log del CF expireStockAsignadoWaitlistsCF.
    match /waitlist_expire_log/{logId} {
      allow read: if isAdminOrGerente();
      allow write: if false;
    }

    // v964 (2026-09-17): audit logs de sqCancelExpiredCF.
    // sq_cancel_log_shadow: Fase B (deploy sin riesgo, solo loguea).
    // sq_cancel_log:        Fase C (cancela SQs reales).
    // sq_cancel_skipped_log: Fase C, salvaguardas que evitaron cancelar.
    // Los 3 escritos por CF (Admin SDK). Lectura admin/gerente para audit.
    match /sq_cancel_log_shadow/{logId} {
      allow read: if isAdminOrGerente();
      allow write: if false;
    }
    match /sq_cancel_log/{logId} {
      allow read: if isAdminOrGerente();
      allow write: if false;
    }
    match /sq_cancel_skipped_log/{logId} {
      allow read: if isAdminOrGerente();
      allow write: if false;
    }

    // v799 (2026-09-04): audit log de merges LEAD → alta SAP ejecutados
    // desde el boton "Vincular LEAD ↔ SAP" en Master Clientes. Escrito
    // por admin/gerente cliente-side (batch atomico junto con el update
    // del LEAD + delete del alta SAP duplicada). Lectura admin/gerente.
    match /lead_merge_log/{logId} {
      allow read: if isAdminOrGerente();
      allow create: if isAdminOrGerente();
      allow update, delete: if false;
    }

    // v750 (2026-08-31): tracking de transiciones de state en lines pedidos-app.
    // Escrito por CF onPedidoWriteTrackAsigTransitions (Admin SDK, bypassea rules).
    // Objetivo: analytics mes-a-mes de conversion ASIG -> confirmed/invoiced vs
    // cancelled/recycled. Alimenta view BQ v_asig_conversion_monthly.
    // Read admin/gerente para queries desde Dashboard o Power BI. Write false.
    match /asig_transitions/{transitionId} {
      allow read: if isAdminOrGerente();
      allow write: if false;
    }

    // v1283 (2026-10-20): collections seguimiento_notes + seguimiento_status
    // tiradas junto con el reemplazo del modal Seguimiento por Analisis de Cartera.
    // Backup en ./backups/seguimiento_backup_YYYY-MM-DD.json antes del delete.

    // v1283 (2026-10-20): snapshot nightly del dashboard "Analisis de Cartera".
    // v1556 (2026-11-16): abierto tambien a VDE con scope limitado a SU cartera.
    // - admin/gerente: cualquier doc.
    // - interno: cualquier doc (el dropdown client-side filtra a sus parejas).
    // - vendedor: SOLO su propio vendorKey == /roles/{uid}.vendor (myVendorKey).
    // Writes exclusivos de la CF syncCarteraVendorScheduled via Admin SDK.
    match /cartera_vendor/{vendorKey} {
      allow read: if isAdminOrGerente()
        || isInterno()
        || (isVendor() && vendorKey == myVendorKey());
      allow write: if false;  // only CF via Admin SDK
    }

    match /product_catalog/{docId} {
      allow read: if isReader();
      allow write: if isAdmin();
    }

    // v482 (2026-08-12): facturacion_snapshot escrito por el cron
    // sync_sap_to_bigquery.py (BQ v_ventas_lineas -> Firestore).
    // 1 doc por vendedor + __TOTAL__ nacional con {hoyArs, mesArs, anoArs}.
    // Uso: cards del sidebar-left (Facturacion Diaria + Cumplimiento).
    // Todos los readers pueden leer; el filtro por vendor se aplica
    // client-side segun scope.
    match /facturacion_snapshot/{docId} {
      allow read: if isReader();
      allow write: if false;
    }

    // v532 (2026-08-18): campania_snapshot escrito por el cron
    // sync_sap_to_bigquery.py (BQ v_campanias_progreso -> Firestore).
    // 1 doc por campania con {realizadoQty, realizadoArs, pctCumplimiento, ...}.
    // Alimenta la card 'Campanias activas' del Dashboard con facturado REAL SAP
    // (antes usaba globalPedidos = $0 permanente porque los pedidos van directo
    // a SAP y no via la app).
    match /campania_snapshot/{docId} {
      allow read: if isReader();
      allow write: if false;
    }

    // v641 (2026-08-26): dashboard_visuales/global escrito por el cron
    // sync_sap_to_bigquery.py (BQ v_ventas_lineas -> Firestore) cada 30 min.
    // Contiene topSkus + facturacionDiaria del mes actual. Alimenta el tab
    // Visuales del Dashboard (v640). Read para cualquier isReader (los VDEs
    // ven charts globales de la empresa).
    match /dashboard_visuales/{docId} {
      allow read: if isReader();
      allow write: if false;
    }

    // v454 (2026-08-11): revision_waitlist — pedidos "en espera" cargados
    // desde el modal Revision Excel. Compartido entre los 4 users del
    // whitelist (Mariano/Ioannis/Santi/Pablo = admin/gerente/interno).
    // Read: cualquier reader (los 4 son admin/gerente/interno, todos readers).
    // Create: cualquier reader con ownerUid = auth.uid.
    // v514 (2026-08-13): Update/Delete abierto a cualquier reader (antes
    // solo owner o admin/gerente). Motivo: los VDIs (Santi/Ioannis) cargan
    // pedidos en nombre de los VDEs (Federico/Gonzalo/...) via Revision
    // Excel; cuando el VDE editaba qty o cambiaba orden desde su sesion,
    // Firestore bloqueaba porque el ownerUid era del VDI. La lista de
    // espera es colaborativa por naturaleza -> cualquier reader edita.
    match /revision_waitlist/{docId} {
      allow read: if isReader();
      allow create: if isReader() && request.resource.data.ownerUid == request.auth.uid;
      // v926 (2026-09-14, SecAudit Sprint 1 E1.4 HIGH-06): split update/delete.
      // Antes: update+delete abiertos a cualquier reader (@shimano). Un viewer
      // o VDE hostil podia wipear la lista de espera entera con un forEach
      // desde DevTools. Ahora update sigue abierto (waitlist es colaborativo:
      // VDI/VDE cross-editing es necesario para el flow revision-excel).
      // v953 (2026-09-16): permitir owner delete. Sin esto, cuando un VDE
      // confirmaba un pedido desde la waitlist, el .then() del pedidos.add()
      // fallaba al borrar el waitlist doc → la card seguia en el sidebar →
      // VDE podia re-confirmar el mismo entry 2-3 veces creando SQs duplicadas
      // en SAP. Bug reportado por Mariano 2026-09-16 (CRISTIAN JOSE SANTORO
      // ORDEN 178, 3 SQs 2000183/2000184/2000185). Delete queda scoped al
      // owner del doc — no permite wipe masivo (defensa v926 preservada).
      // Admin/gerente/interno siguen pudiendo borrar cualquier doc.
      //
      // SEC-M1 (Fase 2B, 2026-11-18, reintegrado 2026-11-19 iter 2.2 post
      // red team adversarial): whitelist estricto sobre update directo
      // desde cliente. Los 4 CFs cross-vendor (releaseAsigCF,
      // commitPedidoCF, movePedidoToWaitlistCF, unifyWaitlistsCF) usan
      // Admin SDK y bypassean esta rule.
      //
      // Iteración 2.2 (post red team): whitelist extendido a 20 campos
      // para cubrir flujos legítimos cliente-side pre-existentes:
      //   - "Unificar orden" modal (_wcardUnificarOrden index.html:27378).
      //   - §42 helper (_createOrUnifyWaitlistPayload index.html:18800).
      //   - Marcado de órdenes absorbidas (consumed + unifiedInto).
      //   - Re-resolve §44 vendor en target legacy (pre-§44).
      //
      // Campos bloqueados (solo CF los escribe): clientCardCode, ownerUid,
      // asigRefs, createdAt, createdByUid, cancelledAt, _unifiedFromWaitlistId.
      //
      // Guard legacy §44: los 4 campos de vendor (assignedVendorUid,
      // vendorAssigned, assignedVendorEmail, ownerVendor) solo son
      // modificables si el doc es legacy pre-§44 (resource.data.assignedVendorUid
      // vacío o ausente). VDE hostil que intenta reasignar un waitlist
      // post-§44 es bloqueado (preserva mitigación §59).
      //
      // Riesgos residuales DEUDA-M1-R1 (editar items ajenos) y DEUDA-M1-R2
      // (consumed silencioso ajeno) persisten — Fase 3.
      allow update: if isReader()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          // Contenido editable (modal "Pedido en Espera" + CPST + Excel)
          'items',
          // Editar orderNumber (waitlistEditOrden desde modal)
          'orderNumber',
          // Transicion a consumed via commitPedidoCF flow .then()
          // (index.html:39230 — defense-in-depth v953)
          'stage', 'consumedByPedidoId', 'consumedAt',
          // §42.2 review guard unify local
          'closedAt', 'closedReason',
          'unifiedIntoCurrentOrder', 'unifiedAt', 'unifiedBy',
          // Timestamp update automatico
          'updatedAt',
          // SEC-M1 iter 2.2: Unificar orden target update (audit + heredar CPST)
          'unifiedFrom', 'pedidosOrigenes', 'source',
          // SEC-M1 iter 2.2: Marcado de órdenes absorbidas
          'unifiedInto', 'unifiedIntoOrderNumber',
          // SEC-M1 iter 2.2: Re-resolve §44 en target legacy (con guard abajo)
          'assignedVendorUid', 'vendorAssigned', 'assignedVendorEmail', 'ownerVendor',
          // Ajuste batch 2026-11-24: la carga por Excel guarda la ruta del
          // archivo subido a Storage (index.html revisionDejarRecalculando).
          // Faltaba en #1376: sin esto el Excel original no queda enlazado.
          'sourceExcelPath', 'sourceExcelName'
        ])
        // Guard legacy §44: los 4 campos de vendor solo si resource es legacy
        // (assignedVendorUid vacío o ausente). Preserva mitigación §59.
        && (
          !(
            'assignedVendorUid' in request.resource.data.diff(resource.data).affectedKeys()
            || 'vendorAssigned' in request.resource.data.diff(resource.data).affectedKeys()
            || 'assignedVendorEmail' in request.resource.data.diff(resource.data).affectedKeys()
            || 'ownerVendor' in request.resource.data.diff(resource.data).affectedKeys()
          )
          || resource.data.get('assignedVendorUid', '') == ''
        );
      allow delete: if isAdminOrGerente() || isInterno()
                    || (isReader() && resource.data.ownerUid == request.auth.uid);
    }

    // R01 Fase 1 (v1557-dev 2026-11-17, integrado 2026-11-19 A1.3): locks
    // atomicos para garantizar §42 (a lo sumo 1 waitlist abierta por
    // cardCode). Colección 100% server-side: solo las CFs
    // movePedidoToWaitlistCF / unifyWaitlistsCF escriben via Admin SDK
    // dentro de runTransaction. Los scripts W_waitlist_lock_drift +
    // Y_seed_waitlist_locks también usan Admin SDK (bypassa rules).
    // Nunca cliente.
    match /revision_waitlist_locks/{cardCode} {
      allow read: if false;
      allow write: if false;
    }

    // MERCADOLIBRE (v>=997) -- solo Mariano lee, nadie escribe desde client.
    // La escritura la hace el GHA sync-to-app.yml del repo mercado-intelligence
    // con SA (Admin SDK bypasea rules).
    match /meli/{docId} {
      allow read: if isMariano();
      allow write: if false;
    }
    match /meli_products/{productId} {
      allow read: if isMariano();
      allow write: if false;
    }
    match /meli_categories/{categoryId} {
      allow read: if isMariano();
      allow write: if false;
    }
    match /meli_map_alerts/{alertId} {
      allow read: if isMariano();
      allow write: if false;
    }
    // v1413 §51 + v1414 §51.1 (2026-10-22): resumen historico cliente x SKU
    // para el modal "Reportes Excel > Infracciones MELI". Publicado por el
    // pipeline MI (map-daily.yml step publish_infracciones_firestore.py) con
    // SA mi-sync-writer. Readers: Mariano (2 emails) + Diego Valsi.
    // Ver canReadInfraccionesMeli() arriba — mantener sincronizado con
    // src/domains/exports-core.js INFRACCIONES_MELI_READERS.
    match /meli_infracciones_resumen/{docId} {
      allow read: if canReadInfraccionesMeli();
      allow write: if false;
    }
    match /meli_map_alerts_history/{itemId} {
      allow read: if isMariano();
      allow write: if false;
    }
    match /meli_map_ranking/{sellerNickname} {
      allow read: if isMariano();
      allow write: if false;
    }

    // v1346 Sugerencias de productos para SKUs sin stock libre.
    // Backfill de atributos tecnicos por SKU (scripts/backfill_product_attrs.py).
    // Lectura amplia (todos los roles autenticados consumen el catalogo).
    // Escritura solo admin (el backfill usa admin SDK y bypassa rules).
    match /items_attrs/{sku} {
      allow read: if isReader();
      allow write: if isAdmin();
    }

    // v1350 Buyer-cliente: stats pre-computados por cardCode (CF nocturna).
    // Read authed (todos los roles ven buyer de todos los clientes — decision Mariano).
    // Write SOLO CF (via admin SDK, bypassa rules).
    // _meta_ doc: con status de la ultima corrida (lastRun, duration, errors).
    match /client_buyer_stats/{cardCode} {
      // Lote B (batch 2026-11-24): antes cualquier cuenta logueada (incluso
      // sin rol) leia y listaba la coleccion. Ahora solo roles aprobados.
      allow read: if isReader();
      allow write: if false;
    }

    // v1346 Telemetria del modal de sugerencias. Cada apertura crea un doc;
    // acciones se appendean mientras el modal esta abierto; cierra con closedAt.
    // Create/update solo del propio vendedor (email match). Read admin/gerente.
    // Nunca borrar (historial).
    match /sugerencias_log/{logId} {
      allow create: if request.auth != null
        && request.resource.data.vendedor.email == request.auth.token.email;
      // Update protege campos criticos (vendedor.email, pedidoId, openedAt, appVersion
      // deben mantenerse iguales al original).
      allow update: if request.auth != null
        && resource.data.vendedor.email == request.auth.token.email
        && request.resource.data.vendedor.email == resource.data.vendedor.email
        && request.resource.data.pedidoId == resource.data.pedidoId
        && request.resource.data.openedAt == resource.data.openedAt
        && request.resource.data.appVersion == resource.data.appVersion;
      allow read: if isAdminOrGerente();
      allow delete: if false;
    }
  }
}
