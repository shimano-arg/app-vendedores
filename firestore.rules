rules_version = '2';

// Rules de app-vendedores-shimano.
// Baseline: `firestore.rules.baseline` (snapshot 2026-07-24 desde Console).
// Refactor Fase 0 (rama fase-0):
//   1. `list` de pedidos/visits/rendiciones para vendedor requiere
//      `resource.data.ownerUid == request.auth.uid`. Antes: cualquier
//      reader listaba todo → un vendedor con consola browser podía
//      enumerar visitas/pedidos/rendiciones de otros vendedores.
//      Ahora vendor solo lista sus propios docs. Admin/gerente/interno
//      no cambian (siguen viendo todo — necesario para panels).
//   2. Doc `app_config/sap_integration` (creds SAP): read restringido a
//      admin+gerente. Antes: cualquier reader (incluido viewer) leía
//      las creds. E5 lo elimina moviendo creds a Secret Manager en
//      Cloud Functions.
// Todo lo demás preserva la baseline. Suite de tests contra emulator
// en `tests/rules/` bloquea regresiones.

service cloud.firestore {
  match /databases/{database}/documents {

    function role() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role;
    }
    // v548: vendor name asignado al VDE (matchea POINTS[i].vendor y
    // client_applications.assignedVendor). null si no tiene.
    function myVendorKey() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.vendor;
    }
    function isAdmin() { return request.auth != null && role() == 'admin'; }
    function isViewer() { return request.auth != null && role() == 'viewer'; }
    function isVendor() { return request.auth != null && role() == 'vendedor'; }
    function isInterno() { return request.auth != null && role() == 'interno'; }
    function isGerente() { return request.auth != null && role() == 'gerente'; }
    function isAdminOrGerente() { return isAdmin() || isGerente(); }
    function isReader() { return isAdmin() || isViewer() || isVendor() || isInterno() || isGerente(); }
    function isSeguimientoUser() { return isAdmin() || isGerente() || isInterno(); }
    function ownsDoc() { return request.auth != null && resource.data.ownerUid == request.auth.uid; }

    function isMyPartnerVDE(targetUid) {
      return isInterno()
        && exists(/databases/$(database)/documents/roles/$(targetUid))
        && get(/databases/$(database)/documents/roles/$(targetUid)).data.role == 'vendedor'
        && get(/databases/$(database)/documents/roles/$(targetUid)).data.internalPartnerUid == request.auth.uid;
    }

    match /roles/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || isAdmin()
        || isGerente()
        || resource.data.internalPartnerUid == request.auth.uid
      );
      allow create: if request.auth != null && request.auth.uid == uid
                     && request.resource.data.role in ['unassigned', 'admin'];
      allow update, delete: if isAdmin();
    }

    match /userData/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || isGerente() || isViewer());
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Pedidos: get (por id) abierto a reader; list restringido para vendedor a own.
    match /pedidos/{pedidoId} {
      allow get: if isReader();
      allow list: if isAdminOrGerente() || isInterno() || (isVendor() && ownsDoc());
      allow create: if isAdminOrGerente()
        || (isVendor() && request.resource.data.ownerUid == request.auth.uid)
        || (isInterno()
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.onBehalfOf == false)
        || (isInterno()
            && request.resource.data.createdByUid == request.auth.uid
            && request.resource.data.onBehalfOf == true
            && isMyPartnerVDE(request.resource.data.ownerUid));
      // v747 (2026-08-31): relajada la rule de update/delete para internos.
      // Antes: internos solo podian update pedidos donde eran ownerUid
      // (onBehalfOf=false) o createdByUid (onBehalfOf=true). Bug reportado
      // por Santi (interno): al pasar un pedido de "lista de espera" a
      // "pendientes", el flow ASIG resolve (index.html:16685) hace batch
      // update sobre multiples pedidos de otros vendedores para cancelar/
      // reciclar sus lineas ASIG. Como interno no era owner de esos otros
      // pedidos, la batch fallaba con "Missing or insufficient permissions".
      // Ahora: internos pueden update cualquier pedido (blanket). Justificacion:
      // los 2 internos (Santi/Ioannis) estan en whitelist confiable, ya
      // pueden crear pedidos on-behalf-of vendedores, y necesitan poder
      // resolver ASIG lines cross-vendor para el flow waitlist. VDEs siguen
      // restringidos a sus propios pedidos.
      allow update, delete: if isAdminOrGerente()
        || isInterno()
        || (isVendor() && resource.data.ownerUid == request.auth.uid);
    }

    match /campaigns/{campaignId} {
      allow read: if isReader();
      allow create, update, delete: if isAdminOrGerente();
    }

    // Visits: mismo patrón que pedidos — vendor list solo own.
    match /visits/{visitId} {
      allow get: if isReader();
      allow list: if isAdminOrGerente() || isInterno() || (isVendor() && ownsDoc());
      allow create: if (isAdminOrGerente() || isVendor() || isInterno())
                       && request.resource.data.ownerUid == request.auth.uid
        || (isInterno()
            && request.resource.data.createdByUid == request.auth.uid
            && request.resource.data.onBehalfOf == true
            && isMyPartnerVDE(request.resource.data.ownerUid));
      allow update, delete: if isAdminOrGerente()
        || ((isVendor() || isInterno()) && resource.data.ownerUid == request.auth.uid)
        || (isInterno()
            && resource.data.createdByUid == request.auth.uid
            && resource.data.onBehalfOf == true);
    }

    match /operations_log/{logId} {
      allow read: if isAdmin() || isViewer();
      allow create: if request.auth != null && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /sap_clients/{docId}  { allow read: if isReader(); allow write: if isAdminOrGerente(); }
    match /sap_products/{docId} { allow read: if isReader(); allow write: if isAdminOrGerente(); }
    match /sap_vendors/{docId}  { allow read: if isReader(); allow write: if isAdminOrGerente(); }

    match /route_overrides/{docId} {
      allow read: if isReader();
      allow create: if (isAdminOrGerente() || isVendor()) && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if isAdminOrGerente();
    }

    match /vendor_overrides/{docId} {
      allow read: if isReader();
      allow write: if isAdminOrGerente();
    }

    match /custom_routes/{docId} {
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid || isAdminOrGerente()
      );
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid || isAdminOrGerente()
      );
    }

    match /notifications/{docId} {
      allow read: if request.auth != null && (
        resource.data.targetUid == request.auth.uid
        || resource.data.fromUid == request.auth.uid
        || isAdmin() || isGerente()
      );
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.targetUid == request.auth.uid;
      allow delete: if isAdminOrGerente()
        || (request.auth != null && resource.data.targetUid == request.auth.uid);
    }

    match /targets/{docId} {
      allow read: if isReader();
      allow create, update: if isAdminOrGerente();
      allow delete: if isAdminOrGerente();
    }

    // v367+ (2026-07-30): sap_snapshot es escrito SOLO por el service account
    // del cron sync_sap_to_bigquery.py (via Firebase Admin SDK, que bypassea
    // Rules). Los usuarios web solo leen; el filtro por vendedor se aplica
    // client-side via getMyAllowedVendorKeys() en dashboard.js.
    match /sap_snapshot/{docId} {
      allow read: if isReader();
      allow write: if false;
    }

    // v398+ (2026-08-05): backorder_snapshot escrito por el cron
    // sync_sap_to_bigquery.py (BQ v_backorder_lineas -> Firestore).
    // 1 doc por vendedor con array `lines` de SQ pendientes de despacho.
    // Uso: nueva tab BACKORDERS de la app.
    // Vendedores leen solo el suyo (filtro client-side); admin/gerente/interno
    // pueden leer todos.
    match /backorder_snapshot/{docId} {
      allow read: if isReader();
      allow write: if false;
    }

    // v42x+ (2026-08-06): sku_ventas_snapshot escrito por el cron
    // sync_sap_to_bigquery.py (BQ v_ventas_lineas ventana 13m -> Firestore).
    // 1 doc por SKU (~755) con map `meses` YYYY-MM -> {qty, ars} + familia/subfamilia.
    // Uso: modal FORECAST (src/domains/forecast.js) admin-only. Solo admin lee
    // porque son datos crudos de venta por SKU (competitivamente sensibles);
    // no hay razon para exponerlos a vendedores o viewers.
    match /sku_ventas_snapshot/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /client_locations/{docId} {
      allow read: if isReader();
      allow create: if isAdminOrGerente() || isVendor() || isInterno();
      allow update, delete: if isAdminOrGerente();
    }

    match /client_master/{docId} {
      allow read: if isReader();
      allow create, update: if isAdminOrGerente();
      // v778+: cualquier reader puede borrar la direccion guardada de un
      // cliente (limpieza colaborativa desde Master Clientes-Direcciones).
      // Solo borra client_master (address del cliente), NO borra el cliente
      // del padron POINTS ni del BP en SAP. Restringido a isReader() para
      // que solo cuentas autenticadas del equipo lo puedan hacer.
      allow delete: if isReader();
    }

    match /allowed_emails/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /client_applications/{docId} {
      // v548: restringir visibilidad de leads/altas a VDE por assignedVendor.
      // Antes: cualquier isReader() veia TODOS los docs (VDE veian leads
      // sin asignar + leads de otros VDEs). Ahora:
      //   - admin/gerente/viewer/interno: ven todo (backward compat).
      //   - vendedor: ve solo si assignedVendor == su vendor key OR fue
      //     creador del doc (ownerUid, necesario para tab "Mis solicitudes"
      //     en notificaciones.js:113 que query .where('ownerUid','==',uid)).
      // Interno (VDI) queda con acceso amplio server-side; filtro por
      // partner-vendors se hace client-side en getMyAllowedVendorKeys().
      // Full enforcement server-side de interno requeriria denormalizar
      // partner list en roles/{uid} — TODO post-v548.
      allow read: if isAdminOrGerente() || isViewer() || isInterno()
                   || (isVendor() && (
                        resource.data.assignedVendor == myVendorKey()
                        || resource.data.ownerUid == request.auth.uid
                      ));
      allow create: if (request.auth != null && request.resource.data.ownerUid == request.auth.uid)
                 || (request.resource.data.submittedByPublicForm == true
                     && request.resource.data.comercio is string
                     && request.resource.data.cuit is string
                     && request.resource.data.status == 'pending_approval');
      // v396 (2026-08-04): permitir a cualquier reader (vendedor incluido)
      // updatear SOLO los campos de estado del LEAD (leadEstado + auditoria).
      // Los demas campos siguen restringidos a admin/gerente/interno.
      // v776 (2026-09-02): fix bug reportado por Mariano — vendedores tocaban
      // "Editar direccion" (openSapAltaAddressModal en index.html:7785, con
      // comentario "v342+: vendedores + interno pueden editar direccion +
      // localidad") pero al confirmar Firestore rechazaba porque la whitelist
      // no incluia esos campos. Ahora extiendo la whitelist con los campos
      // que el flow de editar direccion + geocoding escribe:
      //   calle, localidad, localidadFinal, lat, lng, geoDisplay,
      //   geoPrecision, geoProvider, geoAt, updatedBy.
      // Restos (comercio, titular, cuit, cardCodeSap, precaucion*) siguen
      // restringidos a admin/gerente/interno.
      allow update: if isAdminOrGerente() || isInterno()
                     || (isReader()
                         && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly([
                              'leadEstado', 'leadEstadoAt', 'leadEstadoBy',
                              'calle', 'localidad', 'localidadFinal',
                              'lat', 'lng',
                              'geoDisplay', 'geoPrecision', 'geoProvider', 'geoAt',
                              'updatedAt', 'updatedBy'
                            ]));
      // v778+: cualquier reader puede borrar un provisorio (client_applications
      // sin cardCodeSap) desde Master Clientes-Direcciones. Antes solo el
      // owner o admin/gerente. Ahora VDE/VDI pueden limpiar duplicados de
      // Alta Rapida sin depender del admin. Docs con cardCodeSap (BPs SAP
      // ya cargados) siguen protegidos: solo admin/gerente los borra para
      // evitar dejar pedidos huerfanos.
      allow delete: if isAdminOrGerente()
        || (isReader()
            && (!('cardCodeSap' in resource.data) || resource.data.cardCodeSap == null));
    }

    // Rendiciones: mismo patrón — vendor list solo own.
    match /rendiciones/{docId} {
      allow get: if isReader();
      allow list: if isAdminOrGerente() || isInterno() || (isVendor() && ownsDoc());
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdminOrGerente();
      allow delete: if isAdminOrGerente();
    }

    // app_config: doc-specific overrides.
    // - sap_integration: contiene creds SAP → SOLO admin+gerente (los únicos
    //   que envían pedidos vía SL desde browser). E5 mueve las creds a
    //   Secret Manager y esta rule podrá cerrarse aún más.
    // - v551: gemini también cerrado a admin+gerente. Antes era isReader()
    //   (todos los @shimano leían la API key). Ahora la key vive en Secret
    //   Manager (Cloud Function geminiOcrProxy) y el doc en Firestore queda
    //   como legacy vacío. Cerrar la rule evita que un doc con key vieja/
    //   duplicada sea legible por un VDE. Post-deploy borrar el doc entero.
    // - resto (google_maps, price_list*, product_catalog_meta,
    //   stock_snapshot, users_directory): reader (todos necesitan).
    match /app_config/{docId} {
      // v542 E2: sap_sync_state es info operativa del sync SAP Invoices ->
      // pedidos-app. Solo admin/gerente para no exponer cursores/estado a
      // vendedores que no la necesitan.
      // E3 stock_snapshot_shadow_v3: shadow del snapshot app-source, admin/gerente
      // (info operacional del sync, no relevante a vendedores hasta cutover E5).
      allow read: if (docId in ['sap_integration', 'sap_sync_state', 'stock_snapshot_shadow_v3', 'gemini'] && isAdminOrGerente())
                  || (!(docId in ['sap_integration', 'sap_sync_state', 'stock_snapshot_shadow_v3', 'gemini']) && isReader());
      allow write: if isAdmin();
    }

    // v542 E2: audit log del sync SAP Invoices. Escrito por Cloud Function
    // (Admin SDK, bypass rules). Lectura para admin/gerente (monitoring).
    match /sap_sync_log/{logId} {
      allow read: if isAdminOrGerente();
      allow write: if false; // solo CF via Admin SDK
    }

    // v544 E4.5: audit log del FIFO auto-assign BO->ASIG. Escrito por CF
    // onStockChangeFIFOAssign. Lectura admin/gerente. Shadow y active
    // usan collections separadas hasta cutover E5.
    match /stock_assignment_log/{logId} {
      allow read: if isAdminOrGerente();
      allow write: if false;
    }
    match /stock_assignment_log_shadow/{logId} {
      allow read: if isAdminOrGerente();
      allow write: if false;
    }

    // v561 E7 TTL: audit log de expiraciones diarias de ASIG > 30d.
    // Escrito por CF expireAsigLinesTTLCF (Admin SDK). Lectura admin/gerente.
    match /asig_ttl_log/{logId} {
      allow read: if isAdminOrGerente();
      allow write: if false;
    }

    // v750 (2026-08-31): tracking de transiciones de state en lines pedidos-app.
    // Escrito por CF onPedidoWriteTrackAsigTransitions (Admin SDK, bypassea rules).
    // Objetivo: analytics mes-a-mes de conversion ASIG -> confirmed/invoiced vs
    // cancelled/recycled. Alimenta view BQ v_asig_conversion_monthly.
    // Read admin/gerente para queries desde Dashboard o Power BI. Write false.
    match /asig_transitions/{transitionId} {
      allow read: if isAdminOrGerente();
      allow write: if false;
    }

    match /seguimiento_notes/{noteId} {
      allow read: if isSeguimientoUser();
      allow create: if isSeguimientoUser()
                     && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdminOrGerente()
                             || (request.auth != null
                                 && resource.data.authorUid == request.auth.uid);
    }

    match /seguimiento_status/{statusId} {
      allow read: if isSeguimientoUser();
      allow write: if isSeguimientoUser()
                    && request.resource.data.authorUid == request.auth.uid;
    }

    match /product_catalog/{docId} {
      allow read: if isReader();
      allow write: if isAdmin();
    }

    // v482 (2026-08-12): facturacion_snapshot escrito por el cron
    // sync_sap_to_bigquery.py (BQ v_ventas_lineas -> Firestore).
    // 1 doc por vendedor + __TOTAL__ nacional con {hoyArs, mesArs, anoArs}.
    // Uso: cards del sidebar-left (Facturacion Diaria + Cumplimiento).
    // Todos los readers pueden leer; el filtro por vendor se aplica
    // client-side segun scope.
    match /facturacion_snapshot/{docId} {
      allow read: if isReader();
      allow write: if false;
    }

    // v532 (2026-08-18): campania_snapshot escrito por el cron
    // sync_sap_to_bigquery.py (BQ v_campanias_progreso -> Firestore).
    // 1 doc por campania con {realizadoQty, realizadoArs, pctCumplimiento, ...}.
    // Alimenta la card 'Campanias activas' del Dashboard con facturado REAL SAP
    // (antes usaba globalPedidos = $0 permanente porque los pedidos van directo
    // a SAP y no via la app).
    match /campania_snapshot/{docId} {
      allow read: if isReader();
      allow write: if false;
    }

    // v641 (2026-08-26): dashboard_visuales/global escrito por el cron
    // sync_sap_to_bigquery.py (BQ v_ventas_lineas -> Firestore) cada 30 min.
    // Contiene topSkus + facturacionDiaria del mes actual. Alimenta el tab
    // Visuales del Dashboard (v640). Read para cualquier isReader (los VDEs
    // ven charts globales de la empresa).
    match /dashboard_visuales/{docId} {
      allow read: if isReader();
      allow write: if false;
    }

    // v454 (2026-08-11): revision_waitlist — pedidos "en espera" cargados
    // desde el modal Revision Excel. Compartido entre los 4 users del
    // whitelist (Mariano/Ioannis/Santi/Pablo = admin/gerente/interno).
    // Read: cualquier reader (los 4 son admin/gerente/interno, todos readers).
    // Create: cualquier reader con ownerUid = auth.uid.
    // v514 (2026-08-13): Update/Delete abierto a cualquier reader (antes
    // solo owner o admin/gerente). Motivo: los VDIs (Santi/Ioannis) cargan
    // pedidos en nombre de los VDEs (Federico/Gonzalo/...) via Revision
    // Excel; cuando el VDE editaba qty o cambiaba orden desde su sesion,
    // Firestore bloqueaba porque el ownerUid era del VDI. La lista de
    // espera es colaborativa por naturaleza -> cualquier reader edita.
    match /revision_waitlist/{docId} {
      allow read: if isReader();
      allow create: if isReader() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isReader();
    }
  }
}
