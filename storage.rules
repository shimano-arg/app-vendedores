rules_version = '2';

// Firebase Storage Security Rules — Shimano App Vendedores
//
// Contexto: el bucket app-vendedores-shimano.firebasestorage.app se usa
// exclusivamente para las fotos de ticket de rendiciones (v308+), bajo el
// path `rendiciones/{ownerUid}/{timestamp}_ticket.{ext}`.
// - El vendedor sube SU propia foto al submitear una rendicion.
// - Admin/gerente leen la foto para aprobar la rendicion.
// - Los urls firmados de download tambien requieren auth.
//
// Cualquier otro path (que no exista hoy) queda bloqueado por default —
// evita que un cliente authenticado escriba archivos fuera de scope.
//
// Reemplaza las rules "test mode" que caducaban el 2026-07-30 y hubieran
// bloqueado toda subida de tickets desde el 2026-07-31 en adelante.

service firebase.storage {
  match /b/{bucket}/o {

    // v993 (2026-09-18, SecAudit run-1 HIGH #7): mirror del helper isReader()
    // de firestore.rules. Bloquea que una orphan account creada via el flow
    // de signInWithEmailPassword (fixed en v993) pueda leer /rendiciones/**
    // aunque logre burlar el kick client-side. Un usuario sin rol asignado
    // en /roles/{uid} devuelve false y la lectura falla con permission-denied.
    // NOTA: storage rules NO pueden hacer `get()` a Firestore directamente;
    // en su lugar Firebase permite usar `firestore.exists()` / `firestore.get()`
    // (documented Rules API para Storage). Ver
    // https://firebase.google.com/docs/rules/rules-language#function.
    function _role() {
      return firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role;
    }
    function isReader() {
      return request.auth != null
        && _role() in ['admin', 'gerente', 'vendedor', 'interno', 'viewer'];
    }

    // Fotos de ticket de rendiciones:
    // - write: el vendedor solo puede escribir en SU propia carpeta
    //   (ownerUid del path == request.auth.uid). Limite 10 MB por archivo
    //   + solo tipos image/*.
    // - read: v993 (SecAudit run-1 HIGH #7): antes `request.auth != null`
    //   dejaba a cualquier authenticated (incluso orphans post-createUser
    //   bypass) leer todas las fotos de rendiciones. Ahora requiere un rol
    //   activo en /roles/{uid} (mismo set que firestore.rules isReader).
    match /rendiciones/{ownerUid}/{allFiles=**} {
      allow read: if isReader();
      allow write: if request.auth != null
                   && request.auth.uid == ownerUid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Excels originales que los VDE suben via Revision Excel para cargar
    // pedidos a la Lista de Espera (v848+, 2026-09-09). Se adjuntan al
    // email de notificacion que reciben Pablo + VDI pareja.
    //
    // v937 (2026-09-14, SecAudit Sprint 2 MED-03 VULN-501+502):
    // 1. Antes: write abierto a cualquier `request.auth != null`. Cualquier
    //    Firebase auth user (incluyendo VDE externo, unassigned, cuentas
    //    obsoletas) podia subir xlsx aca. Comment mentia diciendo "@shimano
    //    only" pero la rule no lo enforceaba. Ahora exige domain gate
    //    @shimano.com.ar o @shimano.uy.
    // 2. Antes: `application/octet-stream` aceptado como fallback -> podian
    //    subir cualquier binario (executables, malware) bajo la excusa que
    //    "algunos browsers no ponen el mime xlsx correcto". Ahora solo mimes
    //    Excel reales. Si un browser lo manda mal, el user tiene que reintentar
    //    con otro browser o la app tiene que fixear el mime antes de subir.
    // 3. Antes: sin path scoping - cualquier user podia pisar el excel de
    //    otro (path `waitlist-excels/algo.xlsx`). Ahora path scopeado a
    //    /waitlist-excels/{ownerUid}/... y el uid del path tiene que
    //    matchear request.auth.uid.
    match /waitlist-excels/{ownerUid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == ownerUid
                   && request.auth.token.email.matches('.*@shimano[.](com[.]ar|uy)$')
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' ||
                       request.resource.contentType == 'application/vnd.ms-excel');
    }

    // Adjuntos del Kanban Planner (v981+, 2026-09-22):
    // - Mariano + admin solo pueden subir attachments (fase 1).
    // - Read: admin/gerente o Mariano whitelist.
    // - Write: Mariano whitelist o admin role, max 10 MB, solo PDF/JPEG/PNG.
    match /planner-attachments/{pedidoId}/{fileName} {
      allow read: if request.auth != null
                   && (request.auth.token.email in ['erbinomariano@gmail.com', 'mariano.erbino@shimano.com.ar']
                       || firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role in ['admin', 'gerente']);
      allow write: if request.auth != null
                    && (request.auth.token.email in ['erbinomariano@gmail.com', 'mariano.erbino@shimano.com.ar']
                        || firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role == 'admin')
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
    }

    // Default: bloquear todo lo demas. Si en el futuro se agrega otro
    // path (ej: fotos de visitas migradas a Storage), agregar un match
    // dedicado arriba con sus propias reglas.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
